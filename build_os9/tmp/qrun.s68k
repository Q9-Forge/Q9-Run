* QCC 68k backend -- PIC single module, generated from stack IR
* a7: operand stack, a5: current frame, d0/d1: scratch/return value

	nam	qrun_p
	psect	qrun_p,0,0,1,0,0

* No private tc_start bootstrap here: cstart.r (the real Microware
* C runtime) calls "main" directly and handles termination itself;
* this leaves a6 untouched as its static data pointer (see the
* framePtr() comment above in the source).

* 68k-Core: int32 MUL/DIV, keine OS- oder Q9-Abhaengigkeit
tc_mul_i32:
	move.l	d2,-(a7)
	move.l	d3,-(a7)
	move.l	d4,-(a7)
	moveq	#0,d2
	moveq	#0,d4
	tst.l	d0
	bpl	tc_mul_a_pos
	neg.l	d0
	addq.l	#1,d4
tc_mul_a_pos:	tst.l	d1
	bpl	tc_mul_b_pos
	neg.l	d1
	eori.l	#1,d4
tc_mul_b_pos:	moveq	#31,d3
tc_mul_loop:	lsr.l	#1,d1
	bcc	tc_mul_skip
	add.l	d0,d2
tc_mul_skip:	add.l	d0,d0
	dbra	d3,tc_mul_loop
	tst.l	d4
	beq	tc_mul_done
	neg.l	d2
tc_mul_done:	move.l	d2,d0
	move.l	(a7)+,d4
	move.l	(a7)+,d3
	move.l	(a7)+,d2
	rts

tc_div_i32:
	move.l	d2,-(a7)
	move.l	d3,-(a7)
	move.l	d4,-(a7)
	move.l	d5,-(a7)
	moveq	#0,d5
	tst.l	d1
	bne	tc_div_nonzero
	moveq	#0,d0
	bra	tc_div_done
tc_div_nonzero:	tst.l	d0
	bpl	tc_div_a_pos
	neg.l	d0
	addq.l	#1,d5
tc_div_a_pos:	tst.l	d1
	bpl	tc_div_b_pos
	neg.l	d1
	eori.l	#1,d5
tc_div_b_pos:	moveq	#0,d2
	moveq	#0,d3
	moveq	#31,d4
tc_div_loop:	lsl.l	#1,d0
	roxl.l	#1,d3
	lsl.l	#1,d2
	cmp.l	d1,d3
	bcs	tc_div_skip
	sub.l	d1,d3
	addq.l	#1,d2
tc_div_skip:	dbra	d4,tc_div_loop
	tst.l	d5
	beq	tc_div_result
	neg.l	d2
tc_div_result:	move.l	d2,d0
tc_div_done:	move.l	(a7)+,d5
	move.l	(a7)+,d4
	move.l	(a7)+,d3
	move.l	(a7)+,d2
	rts

tc_udiv_u32:
	move.l	d2,-(a7)
	move.l	d3,-(a7)
	move.l	d4,-(a7)
	tst.l	d1
	bne	tc_udiv_nonzero
	moveq	#0,d0
	bra	tc_udiv_done
tc_udiv_nonzero:	moveq	#0,d2
	moveq	#0,d3
	moveq	#31,d4
tc_udiv_loop:	lsl.l	#1,d0
	roxl.l	#1,d3
	lsl.l	#1,d2
	cmp.l	d1,d3
	bcs	tc_udiv_skip
	sub.l	d1,d3
	addq.l	#1,d2
tc_udiv_skip:	dbra	d4,tc_udiv_loop
	move.l	d2,d0
tc_udiv_done:	move.l	(a7)+,d4
	move.l	(a7)+,d3
	move.l	(a7)+,d2
	rts

tc_mod_i32:
	move.l	d2,-(a7)
	move.l	d3,-(a7)
	move.l	d0,d2
	move.l	d1,d3
	bsr	tc_div_i32
	move.l	d0,d1
	move.l	d3,d0
	bsr	tc_mul_i32
	sub.l	d0,d2
	move.l	d2,d0
	move.l	(a7)+,d3
	move.l	(a7)+,d2
	rts

tc_umod_u32:
	move.l	d2,-(a7)
	move.l	d3,-(a7)
	move.l	d0,d2
	move.l	d1,d3
	bsr	tc_udiv_u32
	move.l	d0,d1
	move.l	d3,d0
	bsr	tc_mul_i32
	sub.l	d0,d2
	move.l	d2,d0
	move.l	(a7)+,d3
	move.l	(a7)+,d2
	rts

tc_putint:
	link	a5,#0
	move.l	d0,d2
	moveq	#0,d3
	tst.l	d2
	bge	tc_pi_nonneg
	neg.l	d2
	moveq	#1,d3
tc_pi_nonneg:	lea	tc_io_buf+11(pc),a1
	move.b	#13,(a1)
tc_pi_loop:	move.l	d2,d0
	moveq	#10,d1
	bsr	tc_udiv_u32
	move.l	d0,d4
	move.l	d2,d0
	moveq	#10,d1
	bsr	tc_umod_u32
	addi.b	#48,d0
	subq.l	#1,a1
	move.b	d0,(a1)
	move.l	d4,d2
	tst.l	d2
	bne	tc_pi_loop
	tst.l	d3
	beq	tc_pi_go
	subq.l	#1,a1
	move.b	#45,(a1)
tc_pi_go:	lea	tc_io_buf+12(pc),a2
	move.l	a2,d1
	sub.l	a1,d1
	bsr	tc_io_write
	unlk	a5
	rts

tc_putuint:
