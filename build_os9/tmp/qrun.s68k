	bsr	tc_umod_u32
	addi.b	#48,d0
	subq.l	#1,a1
	move.b	d0,(a1)
	move.l	d4,d2
	tst.l	d2
	bne	tc_pu_loop
	lea	tc_io_buf+12(pc),a2
	move.l	a2,d1
	sub.l	a1,d1
	bsr	tc_io_write
	unlk	a5
	rts

tc_putchar:
	link	a5,#0
	lea	tc_io_buf(pc),a1
	move.b	d0,(a1)
	moveq	#1,d1
	bsr	tc_io_write
	unlk	a5
	rts

tc_io_write:
	lea	tc_io_cnt(pc),a2
	move.l	d1,(a2)
	move.l	a1,d1
	move.l	a2,-(a7)
	moveq	#1,d0
	bsr	_os_write
	lea	4(a7),a7
	rts

	align	4
